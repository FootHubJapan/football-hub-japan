# Football API Key (API-Football)
# https://www.api-football.com/ で取得してください
# 無料プラン: 100 requests/day, 有料プラン: 1000+ requests/day
# Proプラン + Deep data + Statistics addon 推奨
API_FOOTBALL_KEY=your-api-football-key-here

# Football Data API Key (football-data.org)
# https://www.football-data.org/ で取得してください
# 無料プラン: 10 requests/minute, 有料プラン: 100+ requests/minute
# Free + Deep Data プラン推奨 (€29/月, 30 calls/分)
# Statistic Add-On で詳細統計データも取得可能
FOOTBALLDATA_KEY=c578337e9eb343d8af3411ab3a2a71a9

# Firebase Configuration
# https://console.firebase.google.com/ で取得してください
FIREBASE_API_KEY=your-firebase-api-key-here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id

# Server Port
PORT=3000

# Rate Limiting Configuration (Optional)
# リクエスト制限の設定（デフォルト値）
FOOTBALL_DATA_RATE_LIMIT=10
API_FOOTBALL_RATE_LIMIT=30 